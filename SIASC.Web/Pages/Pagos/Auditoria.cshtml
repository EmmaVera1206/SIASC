@page
@model SIASC.Web.Pages.Pagos.AuditoriaModel

@{
    ViewData["Title"] = "Auditoría financiera";
    var cultura = new System.Globalization.CultureInfo("es-MX");
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                Auditoría financiera
            </h1>

            <p class="text-muted mb-0">
                Consulta los cambios realizados sobre los pagos registrados.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Pagos/Index"
               class="btn btn-outline-secondary">
                Historial de pagos
            </a>

            <a asp-page="/Pagos/Saldos"
               class="btn btn-outline-primary">
                Control de saldos
            </a>
        </div>
    </div>

    @if (Model.TramiteId.HasValue)
    {
        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                Mostrando movimientos del trámite
                <strong>#@Model.TramiteId</strong>.
            </span>

            <a asp-page="/Pagos/Auditoria"
               class="btn btn-sm btn-outline-primary">
                Ver toda la auditoría
            </a>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Movimientos de auditoría
                    </small>

                    <h3 class="mb-0">
                        @Model.TotalMovimientos
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <small class="text-muted">
                        Anulaciones registradas
                    </small>

                    <h3 class="mb-0 text-danger">
                        @Model.TotalAnulaciones
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-light">
            <h5 class="mb-0">
                Historial de movimientos
            </h5>
        </div>

        <div class="card-body">

            @if (!Model.Movimientos.Any())
            {
                <div class="text-center py-5">
                    <h5>No existen movimientos de auditoría</h5>

                    <p class="text-muted mb-0">
                        Los cambios financieros auditados aparecerán aquí.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Pago</th>
                                <th>Cliente / trámite</th>
                                <th>Movimiento</th>
                                <th>Importe</th>
                                <th>Usuario</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var movimiento in Model.Movimientos)
                            {
                                <tr>
                                    <td>
                                        @movimiento.FechaCambio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <strong>
                                            #@movimiento.PagoId
                                        </strong>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @movimiento.NombreCliente
                                        </div>

                                        <div class="small text-muted">
                                            Trámite #@movimiento.TramiteId
                                            - @movimiento.NombreServicio
                                        </div>
                                    </td>

                                    <td>
                                        @if (movimiento.TipoCambio == "Anulacion")
                                        {
                                            <span class="badge bg-danger">
                                                Anulación
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @movimiento.TipoCambio
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @movimiento.Monto.ToString("C2", cultura)
                                    </td>

                                    <td>
                                        @movimiento.NombreUsuario
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#auditoria-@movimiento.CambioPagoId"
                                                    aria-expanded="false"
                                                    aria-controls="auditoria-@movimiento.CambioPagoId">
                                                Ver detalles
                                            </button>

                                            <a asp-page="/Tramites/Detalle"
                                               asp-route-id="@movimiento.TramiteId"
                                               class="btn btn-sm btn-outline-secondary">
                                                Ver trámite
                                            </a>

                                        </div>
                                    </td>
                                </tr>

                                <tr class="collapse"
                                    id="auditoria-@movimiento.CambioPagoId">

                                    <td colspan="7">

                                        <div class="bg-light rounded p-3">

                                            <h6 class="fw-bold mb-3">
                                                Movimiento #@movimiento.CambioPagoId
                                            </h6>

                                            <div class="mb-3">
                                                <strong>Motivo del cambio:</strong>

                                                <p class="mb-0 mt-1"
                                                   style="white-space: pre-wrap;">@movimiento.Motivo</p>
                                            </div>

                                            <div class="row g-3">

                                                <div class="col-md-6">
                                                    <strong>
                                                        Datos anteriores
                                                    </strong>

                                                    <pre class="border rounded p-3 mt-2 bg-white small"
                                                         style="white-space: pre-wrap; overflow-wrap: anywhere;">@movimiento.DatosAnteriores</pre>
                                                </div>

                                                <div class="col-md-6">
                                                    <strong>
                                                        Datos posteriores
                                                    </strong>

                                                    <pre class="border rounded p-3 mt-2 bg-white small"
                                                         style="white-space: pre-wrap; overflow-wrap: anywhere;">@movimiento.DatosNuevos</pre>
                                                </div>

                                            </div>

                                        </div>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
