@page
@model SIASC.Web.Pages.Tramites.CrearModel

@{
    ViewData["Title"] = "Nuevo trámite";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="mb-4">
                <a asp-page="/Tramites/Index"
                   class="text-decoration-none small">
                    &larr; Volver a trámites
                </a>

                <h1 class="h3 fw-bold mt-3 mb-1">
                    Registrar nuevo trámite
                </h1>

                <p class="text-muted">
                    Selecciona el cliente, el servicio solicitado
                    y registra la información inicial.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <h2 class="h5 fw-bold mb-3">
                            Información del trámite
                        </h2>

                        <div class="mb-3">
                            <label asp-for="Input.ClienteId"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Input.ClienteId"
                                    asp-items="Model.Clientes"
                                    class="form-select">

                                <option value="">
                                    Selecciona un cliente
                                </option>

                            </select>

                            <span asp-validation-for="Input.ClienteId"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Solo se muestran clientes activos.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.TipoServicioId"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Input.TipoServicioId"
                                    asp-items="Model.Servicios"
                                    class="form-select">

                                <option value="">
                                    Selecciona un servicio
                                </option>

                            </select>

                            <span asp-validation-for="Input.TipoServicioId"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.CostoTotal"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Input.CostoTotal"
                                       type="number"
                                       min="0"
                                       max="999999999.99"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="0.00" />

                                <span class="input-group-text">
                                    MXN
                                </span>
                            </div>

                            <span asp-validation-for="Input.CostoTotal"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Ingresa el costo acordado del servicio.
                                No representa un pago recibido.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ObservacionesGenerales"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Input.ObservacionesGenerales"
                                      class="form-control"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Información adicional del trámite (opcional)">
                            </textarea>

                            <span asp-validation-for="Input.ObservacionesGenerales"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="alert alert-info">
                            <strong>Estado inicial:</strong> Registrado.

                            <div class="small mt-1">
                                SIASC asignará automáticamente este estado
                                y guardará el primer movimiento del historial.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-page="/Tramites/Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Registrar trámite
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
