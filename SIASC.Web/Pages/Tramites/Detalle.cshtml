@page "{id:int}"
@model SIASC.Web.Pages.Tramites.DetalleModel

@{
    ViewData["Title"] = "Detalle del trámite";
    var cultura = new System.Globalization.CultureInfo("es-MX");
    var porcentaje = Model.PorcentajePagado.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <a asp-page="/Tramites/Index"
               class="text-decoration-none small">
                &larr; Volver a trámites
            </a>

            <h1 class="h3 fw-bold mt-2 mb-1">
                Trámite #@Model.Tramite!.TramiteId
            </h1>

            <p class="text-muted mb-2">
                @Model.Tramite.NombreServicio
            </p>

            @if (Model.Tramite.CodigoEstado == "FINALIZADO")
            {
                <span class="badge bg-success">
                    @Model.Tramite.NombreEstado
                </span>
            }
            else if (Model.Tramite.CodigoEstado == "CANCELADO")
            {
                <span class="badge bg-danger">
                    @Model.Tramite.NombreEstado
                </span>
            }
            else
            {
                <span class="badge bg-primary">
                    @Model.Tramite.NombreEstado
                </span>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">

            @if (Model.EsTramiteVisa)
            {
                <a asp-page="/FormulariosVisa/DatosPersonales"
                   asp-route-id="@Model.Tramite.TramiteId"
                   class="btn btn-outline-primary">
                    @(Model.TieneFormularioVisa
                        ? "Continuar formulario de visa"
                        : "Iniciar formulario de visa")
                </a>

                @if (Model.TieneFormularioVisa)
                {
                    <a asp-page="/FormulariosVisa/Resumen"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-outline-secondary">
                        Ver resumen de visa
                    </a>
                }
            }

            @if (Model.EsTramitePasaporte)
            {
                <a asp-page="/Pasaportes/Datos"
                   asp-route-id="@Model.Tramite.TramiteId"
                   class="btn btn-outline-primary">
                    @(Model.TieneDatosPasaporte
                        ? "Continuar datos de pasaporte"
                        : "Capturar datos de pasaporte")
                </a>

                @if (Model.TieneDatosPasaporte)
                {
                    <a asp-page="/Pasaportes/Resumen"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-outline-secondary">
                        Ver resumen de pasaporte
                    </a>
                }
            }

            @if (Model.PuedeCambiarEstado)
            {
                <a asp-page="/Tramites/CambiarEstado"
                   asp-route-id="@Model.Tramite.TramiteId"
                   class="btn btn-primary">
                    Cambiar estado
                </a>
            }
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["MensajeExito"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["MensajeError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- INFORMACIÓN GENERAL Y CLIENTE -->

    <div class="row g-4">

        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-4">
                        Información del trámite
                    </h2>

                    <dl class="row mb-0">

                        <dt class="col-sm-5 text-muted">Folio</dt>
                        <dd class="col-sm-7">
                            #@Model.Tramite.TramiteId
                        </dd>

                        <dt class="col-sm-5 text-muted">Servicio</dt>
                        <dd class="col-sm-7">
                            @Model.Tramite.NombreServicio
                        </dd>

                        <dt class="col-sm-5 text-muted">Estado actual</dt>
                        <dd class="col-sm-7">
                            @Model.Tramite.NombreEstado
                        </dd>

                        <dt class="col-sm-5 text-muted">Costo total</dt>
                        <dd class="col-sm-7 fw-semibold">
                            @Model.Tramite.CostoTotal.ToString("C2", cultura)
                        </dd>

                        <dt class="col-sm-5 text-muted">Fecha de inicio</dt>
                        <dd class="col-sm-7">
                            @Model.Tramite.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-5 text-muted">
                            Última actualización
                        </dt>
                        <dd class="col-sm-7">
                            @Model.Tramite.FechaUltimaActualizacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-5 text-muted">Fecha de cierre</dt>
                        <dd class="col-sm-7">
                            @(Model.Tramite.FechaCierre.HasValue
                                ? Model.Tramite.FechaCierre.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                : "No cerrado")
                        </dd>

                    </dl>

                    <hr />

                    <h3 class="h6 fw-bold">
                        Observaciones generales
                    </h3>

                    <p class="mb-0"
                       style="white-space: pre-wrap;">@(Model.Tramite.ObservacionesGenerales ?? "Sin observaciones registradas.")</p>

                    @if (!string.IsNullOrWhiteSpace(Model.Tramite.MotivoCancelacion))
                    {
                        <hr />

                        <h3 class="h6 fw-bold text-danger">
                            Motivo de cancelación
                        </h3>

                        <p class="mb-0">
                            @Model.Tramite.MotivoCancelacion
                        </p>
                    }

                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-4">
                        Cliente asociado
                    </h2>

                    <h3 class="h6 fw-semibold">
                        @Model.Tramite.NombreCliente
                    </h3>

                    <dl class="row mt-3">

                        <dt class="col-sm-5 text-muted">Teléfono</dt>
                        <dd class="col-sm-7">
                            @Model.Tramite.TelefonoCliente
                        </dd>

                        <dt class="col-sm-5 text-muted">Correo</dt>
                        <dd class="col-sm-7">
                            @(Model.Tramite.CorreoCliente ?? "No registrado")
                        </dd>

                    </dl>

                    <a asp-page="/Clientes/Detalle"
                       asp-route-id="@Model.Tramite.ClienteId"
                       class="btn btn-outline-primary">
                        Ver ficha del cliente
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- CONTROL FINANCIERO -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Control financiero
                    </h2>

                    <p class="text-muted small mb-0">
                        Consulta los pagos, saldos y movimientos financieros de este trámite.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    @if (Model.EstadoFinanciero == "Liquidado")
                    {
                        <span class="badge bg-success">
                            Liquidado
                        </span>
                    }
                    else if (Model.EstadoFinanciero == "Parcial")
                    {
                        <span class="badge bg-warning text-dark">
                            Pago parcial
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Sin pagos
                        </span>
                    }

                    @if (Model.SaldoPendienteCentavos > 0)
                    {
                        <a asp-page="/Pagos/Crear"
                           asp-route-id="@Model.Tramite.TramiteId"
                           class="btn btn-primary btn-sm">
                            Registrar pago
                        </a>
                    }

                    <a asp-page="/Pagos/Auditoria"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-outline-dark btn-sm">
                        Auditoría financiera
                    </a>

                    <a asp-page="/Pagos/Index"
                       class="btn btn-outline-secondary btn-sm">
                        Historial general
                    </a>

                    <a asp-page="/Pagos/Saldos"
                       class="btn btn-outline-secondary btn-sm">
                        Control de saldos
                    </a>

                </div>
            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <small class="text-muted">
                            Costo total
                        </small>

                        <h3 class="h4 fw-bold mb-0">
                            @Model.Tramite.CostoTotal.ToString("C2", cultura)
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <small class="text-muted">
                            Total pagado
                        </small>

                        <h3 class="h4 fw-bold text-success mb-0">
                            @Model.TotalPagado.ToString("C2", cultura)
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3 h-100">
                        <small class="text-muted">
                            Saldo pendiente
                        </small>

                        <h3 class="h4 fw-bold text-primary mb-0">
                            @Model.SaldoPendiente.ToString("C2", cultura)
                        </h3>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-semibold">
                    Progreso de pago
                </span>

                <span class="small text-muted">
                    @Model.PorcentajePagado.ToString("0.##")%
                </span>
            </div>

            <div class="progress mb-4" style="height: 12px;">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: @(porcentaje)%;"
                     aria-valuenow="@porcentaje"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h3 class="h6 fw-bold mb-0">
                    Pagos registrados
                </h3>

                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-success">
                        @Model.TotalPagosVigentes vigente(s)
                    </span>

                    @if (Model.TotalPagosAnulados > 0)
                    {
                        <span class="badge bg-danger">
                            @Model.TotalPagosAnulados anulado(s)
                        </span>
                    }
                </div>
            </div>

            @if (Model.Pagos.Count == 0)
            {
                <p class="text-muted small mb-0">
                    Este trámite todavía no tiene pagos registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Método</th>
                                <th>Referencia</th>
                                <th>Importe</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var pago in Model.Pagos)
                            {
                                <tr>
                                    <td>
                                        @pago.FechaPago.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @pago.TipoPago
                                    </td>

                                    <td>
                                        @pago.MetodoPago
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(pago.Referencia)
                                            ? "Sin referencia"
                                            : pago.Referencia)
                                    </td>

                                    <td>
                                        <strong class="@(pago.Anulado ? "text-decoration-line-through text-muted" : "")">
                                            @pago.Monto.ToString("C2", cultura)
                                        </strong>
                                    </td>

                                    <td>
                                        @if (pago.Anulado)
                                        {
                                            <span class="badge bg-danger">
                                                Anulado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Vigente
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            @if (!pago.Anulado)
                                            {
                                                <a asp-page="/Pagos/Anular"
                                                   asp-route-id="@pago.PagoId"
                                                   class="btn btn-sm btn-outline-danger">
                                                    Anular pago
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-page="/Pagos/Auditoria"
                                                   asp-route-id="@Model.Tramite.TramiteId"
                                                   class="btn btn-sm btn-outline-dark">
                                                    Ver auditoría
                                                </a>
                                            }

                                        </div>
                                    </td>
                                </tr>

                                @if (pago.Anulado &&
                                     !string.IsNullOrWhiteSpace(pago.MotivoAnulacion))
                                {
                                    <tr>
                                        <td colspan="7"
                                            class="small text-danger">
                                            <strong>Motivo de anulación:</strong>
                                            @pago.MotivoAnulacion

                                            @if (pago.FechaAnulacion.HasValue)
                                            {
                                                <div class="text-muted mt-1">
                                                    Fecha de anulación:
                                                    @pago.FechaAnulacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

    <!-- GESTIÓN DOCUMENTAL -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h2 class="h5 fw-bold mb-2">
                        Gestión documental
                    </h2>

                    <p class="text-muted mb-3">
                        Consulta y administra los documentos
                        asociados a este trámite.
                    </p>

                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary">
                            @Model.TotalDocumentosActivos
                        </span>

                        <span class="small text-muted">
                            @(Model.TotalDocumentosActivos == 1
                                ? "documento activo"
                                : "documentos activos")
                        </span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="/Documentos/Index"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-outline-primary">
                        Ver documentos
                    </a>

                    <a asp-page="/Documentos/Cargar"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-primary">
                        Agregar documento
                    </a>
                </div>
            </div>

            @if (Model.TotalDocumentosActivos == 0)
            {
                <hr />

                <p class="small text-muted mb-0">
                    Este trámite todavía no tiene documentos
                    activos registrados.
                </p>
            }

        </div>
    </div>

    <!-- CITAS -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Citas del trámite
                    </h2>

                    <p class="text-muted small mb-0">
                        Consulta las citas programadas y su estado actual.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-secondary">
                        @Model.TotalCitas cita(s)
                    </span>

                    <a asp-page="/Citas/Crear"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-primary btn-sm">
                        Registrar cita
                    </a>

                    <a asp-page="/Citas/Index"
                       class="btn btn-outline-secondary btn-sm">
                        Todas las citas
                    </a>
                </div>
            </div>

            @if (Model.Citas.Count == 0)
            {
                <p class="text-muted small mb-0">
                    Este trámite todavía no tiene citas registradas.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo de cita</th>
                                <th>Lugar</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var cita in Model.Citas)
                            {
                                <tr>
                                    <td>
                                        @if (cita.FechaProgramada.HasValue)
                                        {
                                            <span class="fw-semibold">
                                                @cita.FechaProgramada.Value.ToString("dd/MM/yyyy")
                                            </span>

                                            <div class="small text-muted">
                                                @cita.FechaProgramada.Value.ToString("HH:mm")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin fecha
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @cita.TipoCita
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(cita.Lugar)
                                            ? "No especificado"
                                            : cita.Lugar)
                                    </td>

                                    <td>
                                        @if (cita.EstadoCita == "Confirmada")
                                        {
                                            <span class="badge bg-success">
                                                Confirmada
                                            </span>
                                        }
                                        else if (cita.EstadoCita == "Tentativa")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Tentativa
                                            </span>
                                        }
                                        else if (cita.EstadoCita == "Realizada")
                                        {
                                            <span class="badge bg-primary">
                                                Realizada
                                            </span>
                                        }
                                        else if (cita.EstadoCita == "Cancelada")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @cita.EstadoCita
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-page="/Citas/Editar"
                                           asp-route-id="@cita.CitaId"
                                           class="btn btn-sm btn-outline-primary">
                                            @(cita.EstadoCita == "Realizada" ||
                                              cita.EstadoCita == "Cancelada"
                                                ? "Consultar"
                                                : "Administrar")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

    <!-- PENDIENTES -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Pendientes del trámite
                    </h2>

                    <p class="text-muted small mb-0">
                        Actividades por realizar y seguimiento de tareas.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-secondary">
                        @Model.TotalPendientesAbiertos abierto(s)
                    </span>

                    <a asp-page="/Pendientes/Crear"
                       asp-route-id="@Model.Tramite.TramiteId"
                       class="btn btn-primary btn-sm">
                        Registrar pendiente
                    </a>

                    <a asp-page="/Pendientes/Index"
                       class="btn btn-outline-secondary btn-sm">
                        Todos los pendientes
                    </a>
                </div>
            </div>

            @if (Model.Pendientes.Count == 0)
            {
                <p class="text-muted small mb-0">
                    Este trámite aún no tiene pendientes registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Actividad</th>
                                <th>Fecha límite</th>
                                <th>Prioridad</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var pendiente in Model.Pendientes)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @pendiente.Titulo
                                    </td>

                                    <td>
                                        @(pendiente.FechaVencimiento.HasValue
                                            ? pendiente.FechaVencimiento.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Sin fecha límite")

                                        @if (pendiente.EstaVencido)
                                        {
                                            <span class="badge bg-danger ms-1">
                                                Vencido
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (pendiente.Prioridad == "Alta")
                                        {
                                            <span class="badge bg-danger">
                                                Alta
                                            </span>
                                        }
                                        else if (pendiente.Prioridad == "Media")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Media
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @pendiente.Prioridad
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (pendiente.Estado == "Completado")
                                        {
                                            <span class="badge bg-success">
                                                Completado
                                            </span>
                                        }
                                        else if (pendiente.Estado == "EnProceso")
                                        {
                                            <span class="badge bg-primary">
                                                En proceso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @pendiente.Estado
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-page="/Pendientes/Editar"
                                           asp-route-id="@pendiente.PendienteId"
                                           class="btn btn-sm btn-outline-primary">
                                            @(pendiente.Estado == "Completado"
                                                ? "Consultar"
                                                : "Administrar")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

    <!-- HISTORIAL DE ESTADOS -->

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Historial de estados
                    </h2>

                    <p class="text-muted small mb-0">
                        Movimientos registrados para este trámite.
                    </p>
                </div>

                <span class="badge bg-secondary">
                    @Model.Historial.Count movimiento(s)
                </span>
            </div>

            @if (Model.Historial.Count == 0)
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-0">
                        No hay movimientos registrados.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Estado anterior</th>
                                <th>Estado nuevo</th>
                                <th>Motivo</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var movimiento in Model.Historial)
                            {
                                <tr>
                                    <td>
                                        @movimiento.FechaCambio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(movimiento.EstadoAnterior
                                            ?? "Inicio del trámite")
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @movimiento.EstadoNuevo
                                        </span>
                                    </td>

                                    <td>
                                        @(movimiento.MotivoCambio ?? "—")
                                    </td>

                                    <td>
                                        <span class="small text-muted">
                                            @movimiento.NombreUsuario
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
