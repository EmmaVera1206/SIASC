@page "{id:int}"
@model SIASC.Web.Pages.FormulariosVisa.OcupacionEstudiosModel

@{
    ViewData["Title"] = "Ocupación y estudios";
}

@{
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString();
}


<div class="container py-4">

    <a asp-page="/Tramites/Detalle"
       asp-route-id="@Model.TramiteId"
       class="text-decoration-none small">
        &larr; Volver al trámite
    </a>

    <div class="mt-3 mb-4">
        <h1 class="h3 fw-bold mb-1">
            Formulario de visa americana
        </h1>

        <p class="text-muted mb-1">
            @Model.NombreCliente
        </p>

        <p class="small text-muted">
            Trámite #@Model.TramiteId
        </p>
    </div>
    <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Secciones del formulario de visa">

        <a asp-page="/FormulariosVisa/DatosPersonales"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/DatosPersonales" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/DatosPersonales" ? "page" : null)">
            1. Datos personales
        </a>

        <a asp-page="/FormulariosVisa/PlanesViaje"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/PlanesViaje" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/PlanesViaje" ? "page" : null)">
            2. Planes y gastos
        </a>

        <a asp-page="/FormulariosVisa/HistorialVisa"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/HistorialVisa" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/HistorialVisa" ? "page" : null)">
            3. Historial de visa
        </a>

        <a asp-page="/FormulariosVisa/InformacionFamiliar"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/InformacionFamiliar" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/InformacionFamiliar" ? "page" : null)">
            4. Familia
        </a>

        <a asp-page="/FormulariosVisa/OcupacionEstudios"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/OcupacionEstudios" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/OcupacionEstudios" ? "page" : null)">
            5. Ocupación y estudios
        </a>

        <a asp-page="/FormulariosVisa/InformacionComplementaria"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/InformacionComplementaria" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/InformacionComplementaria" ? "page" : null)">
            6. Complementaria
        </a>

        <a asp-page="/FormulariosVisa/AcompananteViaje"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/AcompananteViaje" ? "btn-primary" : "btn-outline-secondary")"
           aria-current="@(paginaActual == "/FormulariosVisa/AcompananteViaje" ? "page" : null)">
            7. Acompañantes
        </a>

        <a asp-page="/FormulariosVisa/Resumen"
           asp-route-id="@Model.TramiteId"
           class="btn btn-sm @(paginaActual == "/FormulariosVisa/Resumen" ? "btn-primary" : "btn-outline-primary")"
           aria-current="@(paginaActual == "/FormulariosVisa/Resumen" ? "page" : null)">
            Resumen
        </a>

    </nav>
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (!Model.PuedeEditar)
    {
        <div class="alert alert-warning">
            Este formulario ya no está en borrador.
            No se permiten modificaciones.
        </div>
    }

    <form method="post" asp-page-handler="Guardar">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <h2 class="h5 fw-bold mb-4">
                    Ocupación actual
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Input.Ocupacion"
                               class="form-label"></label>

                        <input asp-for="Input.Ocupacion"
                               class="form-control"
                               maxlength="150"
                               placeholder="Ej. Empleado, estudiante, independiente" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.PuestoActual"
                               class="form-label"></label>

                        <input asp-for="Input.PuestoActual"
                               class="form-control"
                               maxlength="150" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.NombreEmpresaActual"
                               class="form-label"></label>

                        <input asp-for="Input.NombreEmpresaActual"
                               class="form-control"
                               maxlength="200" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.DireccionEmpresaActual"
                               class="form-label"></label>

                        <textarea asp-for="Input.DireccionEmpresaActual"
                                  class="form-control"
                                  maxlength="500"
                                  rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.TelefonoEmpresaActual"
                               class="form-label"></label>

                        <input asp-for="Input.TelefonoEmpresaActual"
                               class="form-control"
                               maxlength="30" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.FechaInicioEmpleo"
                               class="form-label"></label>

                        <input asp-for="Input.FechaInicioEmpleo"
                               type="date"
                               class="form-control" />
                    </div>

                </div>

            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">

                <h2 class="h5 fw-bold mb-4">
                    Información académica
                </h2>

                <div class="row g-3">

                    <div class="col-12">
                        <label asp-for="Input.NombreInstitucion"
                               class="form-label"></label>

                        <input asp-for="Input.NombreInstitucion"
                               class="form-control"
                               maxlength="200" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.DireccionInstitucion"
                               class="form-label"></label>

                        <textarea asp-for="Input.DireccionInstitucion"
                                  class="form-control"
                                  maxlength="500"
                                  rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.TelefonoInstitucion"
                               class="form-label"></label>

                        <input asp-for="Input.TelefonoInstitucion"
                               class="form-control"
                               maxlength="30" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.CarreraCurso"
                               class="form-label"></label>

                        <input asp-for="Input.CarreraCurso"
                               class="form-control"
                               maxlength="200" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.FechaInicioEstudios"
                               class="form-label"></label>

                        <input asp-for="Input.FechaInicioEstudios"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Input.FechaInicioEstudios"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.FechaFinEstudios"
                               class="form-label"></label>

                        <input asp-for="Input.FechaFinEstudios"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Input.FechaFinEstudios"
                              class="text-danger small"></span>
                    </div>

                </div>

            </div>
        </div>

        <div class="d-flex justify-content-between mb-4">

            <a asp-page="/FormulariosVisa/InformacionFamiliar"
               asp-route-id="@Model.TramiteId"
               class="btn btn-outline-secondary">
                Anterior
            </a>

            @if (Model.PuedeEditar)
            {
                <button type="submit"
                        class="btn btn-primary">
                    Guardar ocupación y estudios
                </button>
            }

        </div>

    </form>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <h2 class="h5 fw-bold mb-2">
                Empleos anteriores
            </h2>

            <p class="text-muted small mb-4">
                Registra cada empleo anterior del solicitante.
            </p>

            @if (Model.Empleos.Count == 0)
            {
                <div class="alert alert-light border">
                    No hay empleos anteriores registrados.
                </div>
            }
            else
            {
                <div class="table-responsive mb-4">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Empresa</th>
                                <th>Puesto</th>
                                <th>Jefe inmediato</th>
                                <th>Periodo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var empleo in Model.Empleos)
                            {
                                <tr>
                                    <td>@empleo.NombreEmpresa</td>

                                    <td>
                                        @(empleo.Puesto ?? "No registrado")
                                    </td>

                                    <td>
                                        @(empleo.NombreJefeInmediato ?? "No registrado")
                                    </td>

                                    <td>
                                        @(empleo.FechaInicio?.ToString("dd/MM/yyyy") ?? "Sin fecha")
                                        -
                                        @(empleo.FechaTermino?.ToString("dd/MM/yyyy") ?? "Sin fecha")
                                    </td>

                                    <td>
                                        @if (Model.PuedeEditar)
                                        {
                                            <form method="post"
                                                  asp-page-handler="EliminarEmpleo"
                                                  asp-route-id="@Model.TramiteId"
                                                  asp-route-empleoId="@empleo.EmpleoAnteriorId">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('¿Eliminar este empleo anterior?');">
                                                    Eliminar
                                                </button>

                                            </form>
                                        }
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

            @if (Model.PuedeEditar)
            {
                <h3 class="h6 fw-bold mb-3">
                    Agregar empleo anterior
                </h3>

                <form method="post"
                      asp-page-handler="AgregarEmpleo">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="NuevoEmpleo.NombreEmpresa"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.NombreEmpresa"
                                   class="form-control"
                                   maxlength="200" />

                            <span asp-validation-for="NuevoEmpleo.NombreEmpresa"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NuevoEmpleo.Puesto"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.Puesto"
                                   class="form-control"
                                   maxlength="150" />
                        </div>

                        <div class="col-12">
                            <label asp-for="NuevoEmpleo.Direccion"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.Direccion"
                                   class="form-control"
                                   maxlength="500" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NuevoEmpleo.Telefono"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.Telefono"
                                   class="form-control"
                                   maxlength="30" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NuevoEmpleo.NombreJefeInmediato"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.NombreJefeInmediato"
                                   class="form-control"
                                   maxlength="200" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NuevoEmpleo.FechaInicio"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.FechaInicio"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NuevoEmpleo.FechaTermino"
                                   class="form-label"></label>

                            <input asp-for="NuevoEmpleo.FechaTermino"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="NuevoEmpleo.FechaTermino"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 text-end">
                            <button type="submit"
                                    class="btn btn-outline-primary">
                                Agregar empleo anterior
                            </button>
                        </div>

                    </div>

                </form>
            }

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
