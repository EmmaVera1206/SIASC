@page
@model SIASC.Web.Pages.Citas.CrearModel

@{
    ViewData["Title"] = "Registrar cita";
}

<div class="container py-4">

    <a asp-page="/Citas/Index"
       class="text-decoration-none small">
        &larr; Volver a citas
    </a>

    <div class="mt-3 mb-4">
        <h1 class="h3 fw-bold mb-1">
            Registrar nueva cita
        </h1>

        <p class="text-muted">
            Programa una cita relacionada con un trámite.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">
                    <label asp-for="Entrada.TramiteId"
                           class="form-label fw-semibold">
                        Trámite asociado *
                    </label>

                    <select asp-for="Entrada.TramiteId"
                            asp-items="Model.TramitesDisponibles"
                            class="form-select">

                        <option value="">
                            Selecciona un trámite
                        </option>

                    </select>

                    <span asp-validation-for="Entrada.TramiteId"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Entrada.TipoCita"
                           class="form-label fw-semibold">
                        Tipo de cita *
                    </label>

                    <input asp-for="Entrada.TipoCita"
                           class="form-control"
                           maxlength="100"
                           placeholder="Ej. Entrevista consular" />

                    <span asp-validation-for="Entrada.TipoCita"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Entrada.EstadoCita"
                           class="form-label fw-semibold">
                        Estado de la cita *
                    </label>

                    <select asp-for="Entrada.EstadoCita"
                            class="form-select">

                        <option value="Tentativa">
                            Tentativa
                        </option>

                        <option value="Confirmada">
                            Confirmada
                        </option>

                    </select>

                    <span asp-validation-for="Entrada.EstadoCita"
                          class="text-danger small">
                    </span>
                </div>

                <div class="row g-3 mb-4">

                    <div class="col-md-6">
                        <label asp-for="Entrada.FechaTentativa"
                               class="form-label fw-semibold">
                            Fecha tentativa
                        </label>

                        <input asp-for="Entrada.FechaTentativa"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="Entrada.FechaTentativa"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Entrada.FechaConfirmada"
                               class="form-label fw-semibold">
                            Fecha confirmada
                        </label>

                        <input asp-for="Entrada.FechaConfirmada"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="Entrada.FechaConfirmada"
                              class="text-danger small">
                        </span>
                    </div>

                </div>

                <p class="small text-muted mb-4">
                    Para una cita tentativa, captura la fecha
                    tentativa. Para una cita confirmada, captura
                    la fecha confirmada. Utiliza la hora local
                    del lugar donde se realizará la cita.
                </p>

                <div class="mb-4">
                    <label asp-for="Entrada.Lugar"
                           class="form-label fw-semibold">
                        Lugar
                    </label>

                    <input asp-for="Entrada.Lugar"
                           class="form-control"
                           maxlength="300"
                           placeholder="Ej. Consulado de Estados Unidos" />

                    <span asp-validation-for="Entrada.Lugar"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Entrada.Observaciones"
                           class="form-label fw-semibold">
                        Observaciones
                    </label>

                    <textarea asp-for="Entrada.Observaciones"
                              class="form-control"
                              rows="4"
                              maxlength="2000"
                              placeholder="Indicaciones o información adicional">
                    </textarea>

                    <span asp-validation-for="Entrada.Observaciones"
                          class="text-danger small">
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar cita
                    </button>

                    <a asp-page="/Citas/Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
