@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold text-primary">
            Bienvenido a SIASC
        </h1>

        <p class="text-muted">
            Sistema Integral para la Administración,
            Seguimiento de Clientes y Control Financiero
            de Servicios de Tramitación de Visas.
        </p>
    </div>

    <div class="alert alert-success rounded-3">
        <strong>Sesión iniciada correctamente.</strong>

        <div>
            Has accedido al sistema mediante
            una cuenta autorizada.
        </div>
    </div>

    <div class="row g-4 mt-2">

        <div class="col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        Clientes
                    </h2>

                    <p class="text-muted">
                        Registro, consulta y actualización
                        de la información de clientes.
                    </p>

                    <span class="badge bg-secondary">
                        Próximamente
                    </span>

                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        Trámites
                    </h2>

                    <p class="text-muted">
                        Administración de solicitudes,
                        estados, citas y documentos.
                    </p>

                    <span class="badge bg-secondary">
                        Próximamente
                    </span>

                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        Control financiero
                    </h2>

                    <p class="text-muted">
                        Registro de pagos, consulta de
                        saldos y reportes financieros.
                    </p>

                    <span class="badge bg-secondary">
                        Próximamente
                    </span>

                </div>
            </div>
        </div>

    </div>

</div>
