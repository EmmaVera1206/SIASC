@page
@model SIASC.Web.Pages.Clientes.CrearModel

@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="mb-4">
                <h1 class="h3 fw-bold">
                    Registrar nuevo cliente
                </h1>

                <p class="text-muted">
                    Captura la información general del cliente.
                    Los datos específicos de sus servicios
                    se registrarán posteriormente en cada trámite.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.NombreCompleto"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.NombreCompleto"
                                   class="form-control"
                                   placeholder="Nombre y apellidos"
                                   maxlength="200" />

                            <span asp-validation-for="Input.NombreCompleto"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Telefono"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.Telefono"
                                   class="form-control"
                                   type="tel"
                                   placeholder="Ej. 8112345678"
                                   maxlength="20" />

                            <span asp-validation-for="Input.Telefono"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.CorreoElectronico"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.CorreoElectronico"
                                   class="form-control"
                                   type="email"
                                   placeholder="correo@ejemplo.com"
                                   maxlength="200" />

                            <span asp-validation-for="Input.CorreoElectronico"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Este campo es opcional.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.RecomendadoPor"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.RecomendadoPor"
                                   class="form-control"
                                   placeholder="Nombre de quien recomendó al cliente"
                                   maxlength="200" />

                            <span asp-validation-for="Input.RecomendadoPor"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">
                                Puedes dejarlo vacío si el cliente
                                no fue referido por otra persona.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-page="/Clientes/Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar cliente
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
