@page "{id:int}"
@model SIASC.Web.Pages.Documentos.IndexModel

@{
    ViewData["Title"] = "Documentos del trámite";
}

<div class="container py-4">

    <a asp-page="/Tramites/Detalle"
       asp-route-id="@Model.TramiteId"
       class="text-decoration-none small">
        &larr; Volver al trámite
    </a>

    <div class="d-flex flex-wrap justify-content-between
        align-items-start gap-3 mt-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-2">
                Expediente documental
            </h1>

            <p class="text-muted mb-1">
                @Model.NombreCliente
            </p>

            <p class="small text-muted mb-0">
                @Model.NombreServicio
                · Trámite #@Model.TramiteId
            </p>
        </div>

        <a asp-page="/Documentos/Cargar"
           asp-route-id="@Model.TramiteId"
           class="btn btn-primary">
            Agregar documento
        </a>

    </div>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @mensaje

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["MensajeError"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @error

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-2 mb-4">

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Documentos registrados
                    </h2>

                    <p class="text-muted small mb-0">
                        Archivos activos asociados a este trámite.
                    </p>
                </div>

                <span class="badge bg-secondary">
                    @Model.Documentos.Count documento(s)
                </span>

            </div>

            @if (Model.Documentos.Count == 0)
            {
                <div class="text-center py-5">

                    <h3 class="h6 fw-semibold">
                        Sin documentos registrados
                    </h3>

                    <p class="text-muted mb-3">
                        Este trámite todavía no tiene
                        documentos activos.
                    </p>

                    <a asp-page="/Documentos/Cargar"
                       asp-route-id="@Model.TramiteId"
                       class="btn btn-outline-primary">
                        Cargar primer documento
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Tipo de documento</th>
                                <th>Archivo</th>
                                <th>Tamaño</th>
                                <th>Fecha de carga</th>
                                <th>Observaciones</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var documento in Model.Documentos)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @documento.TipoDocumento
                                    </td>

                                    <td>
                                        <span class="text-break">
                                            @documento.NombreOriginal
                                        </span>
                                    </td>

                                    <td class="text-nowrap">
                                        @documento.TamanoLegible
                                    </td>

                                    <td class="text-nowrap">
                                        @documento.FechaCarga.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(
                                            documento.Observaciones))
                                        {
                                            <span class="text-muted">
                                                Sin observaciones
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="white-space: pre-wrap;">
                                                @documento.Observaciones
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end
                                            flex-wrap gap-2">

                                            <a asp-page="/Documentos/Index"
                                               asp-page-handler="Ver"
                                               asp-route-id="@Model.TramiteId"
                                               asp-route-documentoId="@documento.DocumentoId"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-primary">
                                                Ver
                                            </a>

                                            <a asp-page="/Documentos/Index"
                                               asp-page-handler="Descargar"
                                               asp-route-id="@Model.TramiteId"
                                               asp-route-documentoId="@documento.DocumentoId"
                                               class="btn btn-sm btn-outline-secondary">
                                                Descargar
                                            </a>

                                            <form method="post"
                                                  asp-page="/Documentos/Index"
                                                  asp-page-handler="Desactivar"
                                                  asp-route-id="@Model.TramiteId"
                                                  asp-route-documentoId="@documento.DocumentoId"
                                                  onsubmit="return confirm('¿Deseas desactivar este documento? Dejará de estar disponible para consulta y descarga.');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Desactivar
                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <div class="alert alert-info mt-4" role="note">
        Los documentos desactivados dejan de estar disponibles
        para consulta y descarga, pero se conservan en
        el almacenamiento privado para trazabilidad.
    </div>

    <div class="d-flex justify-content-end mt-4">

        <a asp-page="/Tramites/Detalle"
           asp-route-id="@Model.TramiteId"
           class="btn btn-outline-secondary">
            Volver al trámite
        </a>

    </div>

</div>
