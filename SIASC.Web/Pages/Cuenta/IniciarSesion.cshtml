@page
@model SIASC.Web.Pages.Cuenta.IniciarSesionModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h1 class="fw-bold text-primary">SIASC</h1>
                        <p class="text-muted mb-0">
                            Sistema Integral de Administración
                            y Seguimiento de Clientes
                        </p>
                    </div>

                    <h2 class="h5 text-center mb-4">
                        Iniciar sesión
                    </h2>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert">
                    </div>

                    <form method="post"
                          asp-route-returnUrl="@Model.ReturnUrl">

                        <div class="mb-3">
                            <label asp-for="Input.CorreoElectronico"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.CorreoElectronico"
                                   class="form-control"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="correo@ejemplo.com" />

                            <span asp-validation-for="Input.CorreoElectronico"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Contrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Contrasena"
                                   class="form-control"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Ingresa tu contraseña" />

                            <span asp-validation-for="Input.Contrasena"
                                  class="text-danger small">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-2">
                            Iniciar sesión
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <small class="text-muted">
                            Acceso exclusivo para personal autorizado.
                        </small>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

